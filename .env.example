OPENROUTER_API_KEY=
# Optional direct OpenAI Luna diagnostic only; never used by the assignment benchmark.
OPENAI_API_KEY=
OPENROUTER_MOCK_MODE=true
# Paid calls require both this switch and explicit confirmation in the UI.
ALLOW_LIVE=false
API_CALL_BUDGET=1200
API_TIMEOUT_SECONDS=30
API_RETRIES=0
# Fixed for the entire experimental condition; mandatory reasoning cannot be disabled.
CLAUDE_REASONING_EFFORT=low
# Combined completion/reasoning ceiling, not a guarantee of a valid response.
CLAUDE_MAX_TOKENS=1024
API_CONCURRENCY=4
STUDENT_NAME=
STUDENT_ROLL=
DATABASE_PATH=data/cuberace.sqlite3
